# Optional developer settings for this repository's dev tools. Nothing requires this file.
# Copy it to .devtools.env in the main checkout (git-ignored), remove the # from a setting and
# write its value; or set the same names in the environment or in devtools.env under the XDG
# config directory. Precedence: flags, environment, .devtools.env, user file, defaults.
# Never put secrets here. Plain KEY=VALUE lines; values are literal text, never executed.
# Generated by `python3 -m scripts.devconfig example --write`; do not edit by hand.

# [worktrees]

# Directory that holds this repository's work trees, one per branch.
#   default: {XDG_DATA_HOME}/xorchestrate/worktrees/{repo_name}
# XORCHESTRATE_DEV_WORKTREE_ROOT=

# Directory for the work-tree tool's state, logs and its own Serena home.
#   default: {XDG_STATE_HOME}/xorchestrate/worktrees
# XORCHESTRATE_DEV_STATE_DIR=

# Ref new work trees start from; unset means the target of origin/HEAD.
# XORCHESTRATE_DEV_BASE=

# [serena]

# Pinned serena-agent release used for per-tree servers.
#   default: 2.1.0
# XORCHESTRATE_DEV_SERENA_VERSION=

# Serena context passed to per-tree servers.
#   default: claude-code
# XORCHESTRATE_DEV_SERENA_CONTEXT=

# Seconds to wait for a per-tree server to answer a symbol lookup.
#   default: 180
# XORCHESTRATE_DEV_SERENA_TIMEOUT=

# Command that starts a per-tree server; the tool fills the braced fields.
#   default: uvx --python 3.12 --from serena-agent=={version} serena start-mcp-server --context {context} --project {project} --agent-interface tools --transport streamable-http --host 127.0.0.1 --port {port} --open-web-dashboard false
# XORCHESTRATE_DEV_SERENA_COMMAND=

# Serena tool used as the readiness probe; unset derives one from the tree.
# XORCHESTRATE_DEV_PROBE_TOOL=

# JSON object of arguments for the readiness probe tool.
# XORCHESTRATE_DEV_PROBE_ARGS=

# [testkit]

# Directory for test-kit runs when neither --output nor the profile sets one.
#   default: {XDG_STATE_HOME}/xorchestrate/runs/{repo_name}
# XORCHESTRATE_DEV_TESTKIT_OUTPUT=

# Operator profile used when no --profile or --from is given; recorded in runs.
# XORCHESTRATE_DEV_TESTKIT_PROFILE=

# Interpreter for fresh runs without a profile; symbolic links are kept; recorded in runs.
# XORCHESTRATE_DEV_TESTKIT_INTERPRETER=

# Bytecode cache scripts/proof.sh uses when PYTHONPYCACHEPREFIX is unset; outside the checkout.
# XORCHESTRATE_DEV_PYCACHE_PREFIX=

# Native-mode configuration when neither --config nor the profile sets one; recorded in runs.
# XORCHESTRATE_DEV_NATIVE_CONFIG=

# Executable for the default terminal host when no host is selected; recorded in runs.
# XORCHESTRATE_DEV_TERMINAL_BINARY=
