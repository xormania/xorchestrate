{
  "schema_version": 1,
  "id": "xorchestrate.hexagonal",
  "version": "16",
  "description": "Current application-owned ports, infrastructure-independent core and replaceable adapters. Composition is the trusted factory boundary. Source dependencies are distinct from runtime calls through ports. Active live-test infrastructure follows the same dependency direction: generic test-kit ports/core, concrete execution adapters, independent evidence predicates and explicit runner composition. Shared test contracts remain independent of their subjects; support adapters own fixtures, and collected tests cannot import other collected tests. The public ports, their values and errors and the adapter factory convention come from the external, stdlib-only xcontracts package (Apache-2.0), which the foundation re-exports. Roles that reach the foundation allow only xcontracts.ports and xcontracts.model; the conformance kit (xcontracts.testing) and the factory types are allowed only in test support and collected tests; xcontracts never imports xorchestrate, which its own tests and tests/hexagonal/test_xcontracts.py check.",
  "source_roots": [
    "xorchestrate",
    "scripts/testkit",
    "scripts/acceptance",
    "scripts/verification",
    "scripts/architecture",
    "scripts/ci",
    "scripts/devconfig",
    "scripts/worktrees",
    "tests"
  ],
