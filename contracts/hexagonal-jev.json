{
  "endpoint": "https://api.typesafe.ai/v1/systemone",
  "model": "jev-1.14.0",
  "credential_env": "TYPESAFE_API_KEY",
  "timeout": 15,
  "max_source_bytes": 24000,
  "max_files": 8,
  "max_candidates": 3,
  "batch": true,
  "role_priorities": [
    "core",
    "work_acceptance",
    "inspection",
    "adapters",
    "terminal_multiplexer",
    "composition",
    "operator",
    "entrypoints",
    "foundation",
    "telemetry",
    "telemetry_views",
    "testkit_core",
    "testkit_adapters",
    "acceptance_runner"
  ]
}
