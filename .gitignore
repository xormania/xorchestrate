__pycache__/
.venv/
/state/
/runtime-state/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.py[cod]
.ruff_cache/
.claude/settings.local.json

# Local runtime state and editable-install metadata
.xorchestrate/
# Example projects track their configuration like any project.
!examples/*/.xorchestrate/
*.egg-info/
# Committed compatibility fixtures written by the standalone collector.
!tests/fixtures/telemetry/corpus/events.sqlite3
!tests/fixtures/telemetry/bundle/telemetry.sqlite3

# SQLite sidecars created when a committed fixture store is opened in place
tests/fixtures/stores/*-wal
tests/fixtures/stores/*-shm
