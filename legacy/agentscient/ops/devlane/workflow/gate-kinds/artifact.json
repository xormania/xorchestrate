    {"name": "imports", "class": "policy",
     "argv": ["python3", ".dev/contracts/imports.py"], "ci": true},
    {"name": "doc-commands", "class": "policy",
     "argv": ["python3", ".dev/app/workflow/checks/doc_commands.py"], "ci": true},
    {"name": "doc-covers", "class": "policy",
